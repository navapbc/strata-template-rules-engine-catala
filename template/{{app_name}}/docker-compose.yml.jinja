services:
  {{ app_name }}:
    build:
      context: ./
      target: dev
      args:
        - RUN_UID=${RUN_UID:-4000}
        - RUN_USER=${RUN_USER:-app}
    command: ["poetry", "run", "uvicorn", "src.api:app", "--host", "0.0.0.0", "--port", "{{ app_local_port }}", "--reload"]
    env_file:
      - path: ./local.env
        required: true
      - path: ./override.env
        required: false
    environment:
      - PY_RUN_APPROACH=local
      - PYTHONPATH=/app/
    ports:
      - {{ app_local_port }}:{{ app_local_port }}
    # volumes:
    #   - ./:/app
