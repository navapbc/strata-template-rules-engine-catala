# Local environment variables
# Used by docker-compose for local development.
#
# To override values for your own personal local development
# create an override.env file in the same directory.

ENVIRONMENT=local
PORT={{ app_local_port }}

############################
# Logging
############################

# Set log level. Valid values are DEBUG, INFO, WARNING, CRITICAL
# LOG_LEVEL=INFO

############################
# OpenTelemetry
############################

# Service name reported in all traces and metrics (defaults to "{{ app_name }}")
# OTEL_SERVICE_NAME={{ app_name }}

# OTLP collector endpoint. When set, traces and metrics are exported via OTLP/HTTP.
# Leave unset for local development without a collector.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Optional auth header for managed collectors
# OTEL_EXPORTER_OTLP_HEADERS=x-vendor-team=YOUR_API_KEY
